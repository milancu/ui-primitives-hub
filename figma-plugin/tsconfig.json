{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "es5",
      "es6",
      "es7",
      "es2017",
      "es2019",
      "dom"
    ],
    "module": "commonjs",
    "jsx": "react",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@figma"
    ]
  }
}
